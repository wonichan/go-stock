# 复制为 .env 后填写（不要提交 .env）
# Cloudflare Tunnel token（Zero Trust → Networks → Tunnels → 创建隧道后复制）
TUNNEL_TOKEN=
# Cloudflare Access（Zero Trust → Access → Applications → 你的应用 → Overview 中的 Application Audience (AUD) Tag）
CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
CF_ACCESS_AUD=
# 可选：后备密码登录（局域网直连或未配置 Access 时使用）
GO_STOCK_WEB_PASSWORD=
TZ=Asia/Shanghai
# 可选：构建时镜像源（中国大陆网络建议设置），留空使用官方源
# GOPROXY=https://goproxy.cn,direct
# NPM_REGISTRY=https://registry.npmmirror.com
# APT_MIRROR=mirrors.tencent.com
